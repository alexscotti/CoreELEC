--- a/drivers/media/vout/hdmitx21/hw/hdmi_tx_hw.c
+++ b/drivers/media/vout/hdmitx21/hw/hdmi_tx_hw.c
@@ -1964,8 +1964,35 @@
 	}
 	HDMITX_INFO("audio state: %s\n", flag == 0 ? "AUDIO_MUTE" : "AUDIO_UNMUTE");
 	mutex_unlock(&aud_mutex);
+}
+
+/* Hold HDMI audio muted across an audio format change.
+ *
+ * Every hdmitx_set_audmode() ends by unmuting at once. When the sound driver
+ * swaps the output path (i2s PCM <-> spdif bitstream, e.g. a Blu-ray menu's
+ * AC-3 after a PCM or TrueHD segment) the sink is told the new format and gets
+ * the new samples in the same instant, and a receiver that has not yet
+ * re-locked plays the first of them as a burst of noise. On a type change keep
+ * the audio muted and unmute aud_fmt_settle_ms later; another change inside
+ * that window restarts it. The unmute honours whatever mute state the other
+ * paths have set by then. 0 restores the immediate unmute.
+ */
+static uint aud_fmt_settle_ms = 200;
+module_param(aud_fmt_settle_ms, uint, 0644);
+MODULE_PARM_DESC(aud_fmt_settle_ms, "ms HDMI audio stays muted after a format change (0: off)");
+
+static int aud_last_type = -1;
+
+static void aud_settle_fn(struct work_struct *work)
+{
+	struct hdmitx_dev *hdev = get_hdmitx21_device();
+
+	HDMITX_INFO("audio format settled, unmute allowed\n");
+	audio_mute_op(hdev->tx_comm.cur_audio_param.aud_output_en);
 }
 
+static DECLARE_DELAYED_WORK(aud_settle_work, aud_settle_fn);
+
 struct aud_para hdmi21aud_config_data;
 static int hdmitx_set_audmode(struct hdmitx_hw_common *tx_hw, struct aud_para *audio_param)
 {
@@ -2139,7 +2166,16 @@
 		hdmitx_hw_cntl_misc(tx_hw, MISC_AUDIO_RESET, 1);
 	hdmitx21_set_reg_bits(AIP_RST_IVCTX, 0, 0, 1);
 	mutex_unlock(&aud_mutex);
-	audio_mute_op(audio_param->aud_output_en);
+	if (aud_fmt_settle_ms && audio_param->type != aud_last_type) {
+		HDMITX_INFO("audio format %d -> %d, muted %ums\n",
+			aud_last_type, audio_param->type, aud_fmt_settle_ms);
+		audio_mute_op(0);
+		mod_delayed_work(system_wq, &aud_settle_work,
+			msecs_to_jiffies(aud_fmt_settle_ms));
+	} else if (!delayed_work_pending(&aud_settle_work)) {
+		audio_mute_op(audio_param->aud_output_en);
+	}
+	aud_last_type = audio_param->type;
 	return 0;
 }
 
