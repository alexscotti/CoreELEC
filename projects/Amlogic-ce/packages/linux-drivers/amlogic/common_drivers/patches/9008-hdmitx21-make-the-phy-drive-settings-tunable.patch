+
+/* PHY drive overrides, for finding out whether this transmitter's output is
+ * marginal into this AVR.
+ *
+ * Measured 2026-10-19/20: a few seconds into the first play after the GUI the
+ * AVM 70 deasserts HPD and the picture is gone ~1.1s. The box's software does
+ * NOTHING in that window - proven, not assumed: avmute, hdmitx_set_phy,
+ * hdmi_phy_wakeup and every SCDC write were instrumented and none fire across
+ * four captured drops. The Dune, on the same chain and the same
+ * 4K23.975 444 BT2020 10b HDR format, never provokes it in 20 plays.
+ *
+ * What is left is the electrical behaviour of this PHY. These let the drive
+ * registers and rterm be swept on a running box instead of costing a kernel
+ * build per value. 0 means "use the table value"; rterm -1 means "use efuse".
+ */
+static uint phy_ctrl0_override;
+module_param(phy_ctrl0_override, uint, 0644);
+MODULE_PARM_DESC(phy_ctrl0_override, "ANACTRL_HDMIPHY_CTRL0 override (0: table)");
+
+static uint phy_ctrl3_override;
+module_param(phy_ctrl3_override, uint, 0644);
+MODULE_PARM_DESC(phy_ctrl3_override, "ANACTRL_HDMIPHY_CTRL3 override (0: table)");
+
+static uint phy_ctrl5_override;
+module_param(phy_ctrl5_override, uint, 0644);
+MODULE_PARM_DESC(phy_ctrl5_override, "ANACTRL_HDMIPHY_CTRL5 override (0: table)");
+
+static int phy_rterm_override = -1;
+module_param(phy_rterm_override, int, 0644);
+MODULE_PARM_DESC(phy_rterm_override, "rterm 0-15 override (-1: efuse)");
+
