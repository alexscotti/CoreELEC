+
+         BD_DISC_LOG=1        try the known engines
+         BD_DISC_LOG=gv.aN    that class and setter, level 0
+         BD_DISC_LOG=gv.aN=0  the same, level given explicitly
+
+       The names are obfuscated per authoring-tool build, so a disc outside the
+       known set needs the explicit form. Find it with javap on the disc's JAR:
+       the setter is a one-line "public static void x(int)" that writes a static
+       int which the engine's log method compares the message level against. */
+    private static final String[] KNOWN_DISC_LOGGERS = { "gv.aN" };
+
+    private void enableDiscLogging() {
+        String spec = System.getenv("BD_DISC_LOG");
+        if (spec == null)
+            return;
+        spec = spec.trim();
+        if (spec.length() == 0 || spec.equals("0"))
+            return;
+
+        int level = 0;
+        String[] targets;
+        if (spec.equals("1")) {
+            targets = KNOWN_DISC_LOGGERS;
+        } else {
+            int eq = spec.indexOf('=');
+            if (eq >= 0) {
+                try {
+                    level = Integer.parseInt(spec.substring(eq + 1).trim());
+                } catch (NumberFormatException nfe) {
+                    logger.error("BD_DISC_LOG: not a level: " + spec);
+                    return;
+                }
+                spec = spec.substring(0, eq).trim();
+            }
+            targets = new String[] { spec };
+        }
+
+        ClassLoader cl = xlet.getClass().getClassLoader();
+        for (int i = 0; i < targets.length; i++) {
+            int dot = targets[i].lastIndexOf('.');
+            if (dot < 1 || dot == targets[i].length() - 1) {
+                logger.error("BD_DISC_LOG: expected <class>.<method>, got: " + targets[i]);
+                continue;
+            }
+            String cls = targets[i].substring(0, dot);
+            String mth = targets[i].substring(dot + 1);
+            try {
+                Class.forName(cls, true, cl)
+                     .getMethod(mth, new Class[] { int.class })
+                     .invoke(null, new Object[] { new Integer(level) });
+                logger.error("BD_DISC_LOG: enabled via " + cls + "." + mth + "(" + level + ")");
+                return;
+            } catch (ClassNotFoundException cnfe) {
+                /* Not this engine. Try the next candidate. */
+            } catch (Throwable t) {
+                logger.error("BD_DISC_LOG: " + cls + "." + mth + " failed: " + t);
+            }
+        }
+        logger.error("BD_DISC_LOG: no disc logger matched " + java.util.Arrays.asList(targets));
+    }
+
