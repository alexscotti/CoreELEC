[Unit]
Description=Symphony: Kodi userdata the image has to supply
# guisettings.xml: every Symphony setting Kodi does not already default to,
# from the fragments in /usr/share/symphony/guisettings.d/ (symphony-defaults
# ships 10-symphony.xml in every build; symphony-config adds 50-theater.xml
# in our theater's). symphony-userdata-merge writes the file when there is
# none and puts back any of our settings an existing one has lost.
#
# Any other userdata files a package puts in /usr/share/symphony/userdata/
# (symphony-config: cec_HDMI.xml - there is no JSON-RPC for peripheral
# settings - and the CoreELEC Settings add-on's oe_settings.xml) are copied
# with cp -iRp, the idiom userconfig-setup uses: a file already in /storage
# wins, so a setting changed on the box stays changed. A public build has
# none, and the copy does nothing.
#
# Before kodi.service, which is what makes this work for guisettings.xml:
# kodi-config copies Kodi's own default into userdata only if there is none,
# and by then ours is there. Putting ours in /usr/share/kodi/config/ instead
# does NOT work - the kodi package owns that path and installs after us.
DefaultDependencies=no
After=systemd-tmpfiles-setup.service local-fs.target
Before=kodi.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /storage/.kodi/userdata && false | cp -iRp /usr/share/symphony/userdata/* /storage/.kodi/userdata/ &>/dev/null; exit 0'
ExecStart=/usr/lib/symphony/symphony-userdata-merge

[Install]
WantedBy=sysinit.target
