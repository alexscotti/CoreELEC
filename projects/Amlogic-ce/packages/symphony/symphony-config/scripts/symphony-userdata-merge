#!/usr/bin/env python3
"""Put back any setting of ours that Kodi's guisettings.xml has lost.

symphony-userdata.service copies our userdata into /storage with `cp -iRp`, so
a file already there wins and a setting changed on the box stays changed. That
is right for a file that exists, and useless for a file that exists but has
been emptied: a factory reset, a profile reset, or Kodi's own crash-loop safe
mode leaves a four-line guisettings.xml, and the copy then skips it. The box
comes up with Kodi's defaults - no webserver, so no JSON-RPC for the Symphony
driver, and none of the display or audio settings this rig needs.

So: for every setting in our shipped file, if the live file has no setting with
that id at all, add ours. A setting the box already carries is never touched,
whatever its value - including one deliberately set back to Kodi's default,
because Kodi keeps writing the id out (with default="true") once it exists.
"""

import sys
import xml.etree.ElementTree as ET

SHIPPED = "/usr/share/symphony/userdata/guisettings.xml"
LIVE = "/storage/.kodi/userdata/guisettings.xml"


def ids(root):
    return {s.get("id") for s in root.findall("setting") if s.get("id")}


def main(shipped=SHIPPED, live=LIVE):
    try:
        ours = ET.parse(shipped).getroot()
    except (OSError, ET.ParseError) as e:
        print("symphony-userdata-merge: cannot read %s: %s" % (shipped, e))
        return 0

    try:
        tree = ET.parse(live)
    except OSError:
        # No live file: the plain copy already handled it.
        return 0
    except ET.ParseError as e:
        # A truncated file is Kodi's problem to rewrite, not ours to guess at.
        print("symphony-userdata-merge: %s is not parseable (%s), leaving it alone" % (live, e))
        return 0

    root = tree.getroot()
    have = ids(root)
    added = []
    for setting in ours.findall("setting"):
        sid = setting.get("id")
        if sid and sid not in have:
            root.append(setting)
            added.append(sid)

    if not added:
        return 0

    tree.write(live, encoding="UTF-8", xml_declaration=True)
    print("symphony-userdata-merge: restored %d setting(s): %s" % (len(added), " ".join(added)))
    return 0


if __name__ == "__main__":
    sys.exit(main(*sys.argv[1:]))
