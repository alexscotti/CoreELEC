+	 * a release build and become the fault it is reporting.
+	 */
+	if (dropped)
+		pr_info_ratelimited("dvel: bl pts %llu - retired %d stale el frame(s)\n",
+			vf->pts_us64, dropped);
 }
 #endif
 
