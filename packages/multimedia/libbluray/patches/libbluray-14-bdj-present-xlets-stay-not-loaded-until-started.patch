From: SamuriHL <samurihl@msn.com>
Subject: [PATCH] BD-J: a PRESENT xlet reads NOT_LOADED until an application starts it

BDJLoader initialises every PRESENT xlet as soon as a title starts, and
the xlet's AppProxy then reports PAUSED. A player does not load a
PRESENT xlet until an application starts it. BD+ Handshake xlets rely on
that: Turbo 3D's com.macrovision.bdplus.Handshake.exitToXlet() starts the
disc's menu xlet (StandardMenuXlet) only if its proxy reports NOT_LOADED,
and otherwise logs "Application state wasn't NOT_LOADED" and stops. The
loader's init ran on the menu xlet's own thread in parallel, so the disc
started only when the Handshake won the race - most starts hung on a
black screen with the menu xlet's worker waiting for a start that never
came.

Keep the early init, but hide it: a fresh proxy only the loader has
touched reports NOT_LOADED while it is LOADED or PAUSED, and its init
sends no state-change event. Any application call on the proxy (load,
init, start, stop, pause, resume) or the xlet's own notifyPaused /
notifyDestroyed ends that. start() on the pre-initialised xlet goes
straight to startXlet(). An application that load()s or init()s a xlet
it was shown as NOT_LOADED gets a success event, as it would on a
player, although the loader already did the work: its state then reads
LOADED (from the moment load() is called) until the application moves the
xlet on itself, and every state-change event of that move starts from the
LOADED the application was shown. An application call
that arrives before the loader's init has run cancels that init, so the
xlet takes the ordinary lifecycle and listeners never see the loader's
init surface after the application's own load(). A proxy kept from the
previous title is not hidden.

Present since "Only autostart when requested" (2013); unchanged in
libbluray 1.5.1 and master.

--- a/src/libbluray/bdj/java/org/videolan/BDJAppProxy.java
+++ b/src/libbluray/bdj/java/org/videolan/BDJAppProxy.java
@@ -60,11 +60,66 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public int getState() {
-        return state;
+        /* A PRESENT xlet that only the loader has touched (initPresent()) is
+         * still NOT_LOADED to the disc: a player loads it only when an
+         * application starts it. BD+ Handshake xlets (Turbo 3D) start the
+         * disc's menu xlet only while it reports NOT_LOADED, and the early
+         * init raced them. */
+        int s = state;
+        if (presentOnly && (s == LOADED || s == PAUSED))
+            return NOT_LOADED;
+        /* an application whose load() was answered from the loader's early
+         * init believes the xlet LOADED; it is PAUSED underneath until the
+         * application moves it on itself */
+        if (loadedView && s == PAUSED)
+            return LOADED;
+        return s;
+    }
+
+    /* The loader's queued early init, if it has not run yet: an application
+     * call that arrives first cancels it and takes the ordinary path, so the
+     * disc sees one plain lifecycle instead of the loader's init surfacing
+     * after its own load(). Returns true when the init had already run (or is
+     * running), i.e. the application's command must be answered as hidden.
+     * A hidden load() moves getState() straight from NOT_LOADED to the LOADED
+     * view, with no PAUSED visible before its command runs. */
+    private boolean takePresentInit(boolean forLoad) {
+        synchronized (cmds) {
+            AppCommand init = presentInit;
+            presentInit = null;
+            if (!presentOnly)
+                return false;
+            if (init != null && cmds.remove(init)) {
+                presentOnly = false;
+                init.release();
+                return false;
+            }
+            if (forLoad)
+                loadedView = true;
+            presentOnly = false;
+            return true;
+        }
+    }
+
+    /* loader only: initialise a PRESENT xlet ahead of its start */
+    protected void initPresent() {
+        /* only a fresh proxy: one kept from the previous title keeps its state */
+        AppCommand cmd = new AppCommand(AppCommand.CMD_INIT, null);
+        cmd.setLoaderInit(true);
+        synchronized (cmds) {
+            if (state == NOT_LOADED) {
+                presentOnly = true;
+                presentInit = cmd;
+            }
+            cmds.addLast(cmd);
+            cmds.notifyAll();
+        }
     }
 
     public void load() {
+        boolean hidden = takePresentInit(true);
         AppCommand cmd = new AppCommand(AppCommand.CMD_LOAD, null);
+        cmd.setHidden(hidden);
         synchronized (cmds) {
             cmds.addLast(cmd);
             cmds.notifyAll();
@@ -72,7 +127,9 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public void init() {
+        boolean hidden = takePresentInit(false);
         AppCommand cmd = new AppCommand(AppCommand.CMD_INIT, null);
+        cmd.setHidden(hidden);
         synchronized (cmds) {
             cmds.addLast(cmd);
             cmds.notifyAll();
@@ -84,6 +141,7 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public void start(String[] args) {
+        takePresentInit(false);
         AppCommand cmd = new AppCommand(AppCommand.CMD_START, args);
         synchronized (cmds) {
             cmds.addLast(cmd);
@@ -92,6 +150,7 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public void stop(boolean force, int timeout) {
+        takePresentInit(false);
         AppCommand cmd = new AppCommand(AppCommand.CMD_STOP, Boolean.valueOf(force));
         synchronized (cmds) {
             cmds.addLast(cmd);
@@ -109,6 +168,7 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public void pause() {
+        takePresentInit(false);
         AppCommand cmd = new AppCommand(AppCommand.CMD_PAUSE, null);
         synchronized (cmds) {
             cmds.addLast(cmd);
@@ -117,6 +177,7 @@ class BDJAppProxy implements DVBJProxy, Runnable {
     }
 
     public void resume() {
+        takePresentInit(false);
         AppCommand cmd = new AppCommand(AppCommand.CMD_RESUME, null);
         synchronized (cmds) {
             cmds.addLast(cmd);
@@ -350,14 +411,36 @@ class BDJAppProxy implements DVBJProxy, Runnable {
             int fromState = state;
             int toState;
             boolean ret;
+            /* an application loading or initialising a xlet it was shown as
+             * NOT_LOADED gets the success a player would report, even though
+             * the loader already did the work */
+            boolean hiddenDone = cmd.isHidden() && (state == LOADED || state == PAUSED);
+            if (hiddenDone)
+                fromState = NOT_LOADED;
+            /* After a hidden load the application believes the xlet LOADED while
+             * the loader has it PAUSED: every command then starts from the
+             * LOADED it was shown, and its own init() is the LOADED->PAUSED a
+             * player would report, already done. (Not the hidden load itself:
+             * that is the NOT_LOADED->LOADED above.) */
+            boolean hiddenLoad = hiddenDone && cmd.getCommand() == AppCommand.CMD_LOAD;
+            if (loadedView && state == PAUSED && !hiddenLoad && !cmd.isLoaderInit()) {
+                fromState = LOADED;
+                if (cmd.getCommand() == AppCommand.CMD_INIT)
+                    hiddenDone = true;
+            }
+            /* any application command other than a hidden load ends the LOADED
+             * view; the loader's own init (possibly still running when a hidden
+             * load() set it) leaves it alone */
+            if (!cmd.isLoaderInit())
+                loadedView = hiddenLoad;
             switch (cmd.getCommand()) {
             case AppCommand.CMD_LOAD:
                 toState = LOADED;
-                ret = doLoad();
+                ret = doLoad() || hiddenDone;
                 break;
             case AppCommand.CMD_INIT:
                 toState = PAUSED;
-                ret = doInit();
+                ret = doInit() || hiddenDone;
                 break;
             case AppCommand.CMD_START:
                 toState = STARTED;
@@ -377,11 +460,13 @@ class BDJAppProxy implements DVBJProxy, Runnable {
                 ret = doResume();
                 break;
             case AppCommand.CMD_NOTIFY_DESTROYED:
+                presentOnly = false;
                 toState = DESTROYED;
                 state = DESTROYED;
                 ret = true;
                 break;
             case AppCommand.CMD_NOTIFY_PAUSED:
+                presentOnly = false;
                 toState = PAUSED;
                 state = PAUSED;
                 ret = true;
@@ -389,7 +474,12 @@ class BDJAppProxy implements DVBJProxy, Runnable {
             default:
                 return;
             }
-            notifyListeners(fromState, toState, !ret);
+            /* the loader's early init is invisible to applications; a hidden
+             * load reports the LOADED an application asked for */
+            if (hiddenDone && cmd.getCommand() == AppCommand.CMD_LOAD)
+                toState = LOADED;
+            if (!cmd.isLoaderInit())
+                notifyListeners(fromState, toState, !ret);
             cmd.release();
             if (state == DESTROYED)
                 state = NOT_LOADED;
@@ -398,7 +488,10 @@ class BDJAppProxy implements DVBJProxy, Runnable {
 
     private BDJXletContext context;
     private Xlet xlet;
-    private int state;
+    private volatile int state;
+    private volatile boolean presentOnly = false;
+    private volatile boolean loadedView = false;
+    private AppCommand presentInit = null; /* guarded by cmds */
     private LinkedList listeners = new LinkedList();
     private LinkedList cmds = new LinkedList();
     private Thread thread;
@@ -431,6 +524,22 @@ class BDJAppProxy implements DVBJProxy, Runnable {
             return arg;
         }
 
+        public void setHidden(boolean hidden) {
+            this.hidden = hidden;
+        }
+
+        public boolean isHidden() {
+            return hidden;
+        }
+
+        public void setLoaderInit(boolean loaderInit) {
+            this.loaderInit = loaderInit;
+        }
+
+        public boolean isLoaderInit() {
+            return loaderInit;
+        }
+
         public boolean waitDone(int timeoutMs) {
             synchronized (this) {
                 while (!done) {
@@ -466,6 +575,8 @@ class BDJAppProxy implements DVBJProxy, Runnable {
 
         private int cmd;
         private Object arg;
+        private boolean hidden = false;
+        private boolean loaderInit = false;
         private boolean done = false;
     }
 }
--- a/src/libbluray/bdj/java/org/videolan/BDJLoader.java
+++ b/src/libbluray/bdj/java/org/videolan/BDJLoader.java
@@ -297,7 +297,7 @@ public class BDJLoader {
                     proxys[i].start();
                 } else if (code == AppEntry.PRESENT) {
                     logger.info("Init xlet " + i + ": " + appTable[i].getInitialClass());
-                    proxys[i].init();
+                    proxys[i].initPresent();
                 } else {
                     logger.info("Unsupported xlet code (" +code+") xlet " + i + ": " + appTable[i].getInitialClass());
                 }
