+		if (!el || !el->pts_us64)
+			break;
+		if (el->pts_us64 + DVEL_PTS_SLACK_US >= vf->pts_us64)
+			break;
 		if (!recycle_dvel_vf_put())
 			break;
-		i--;
+		dropped++;
