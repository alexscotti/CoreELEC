-	 */
-	memset(&req, 0, sizeof(req));
-	req.aux_size = 0xffffffff;
-	vf_notify_provider_by_name("dvbldec",
-		VFRAME_EVENT_RECEIVER_GET_AUX_DATA, (void *)&req);
-	bl_cnt = req.aux_size;
-
-	memset(&req, 0, sizeof(req));
-	req.aux_size = 0xffffffff;
-	vf_notify_provider_by_name("dveldec",
-		VFRAME_EVENT_RECEIVER_GET_AUX_DATA, (void *)&req);
-
-	if (req.aux_size == 0xffffffff || bl_cnt == 0xffffffff ||
-	    bl_cnt <= req.aux_size)
+	/* Nothing to compare against: stay out of the way entirely. */
+	if (!vf->pts_us64)
 		return;
 
-	i = bl_cnt - req.aux_size;
-	/*
-	 * This runs from the vsync hard-IRQ, once per vsync. Any state where the
-	 * base layer stays ahead of a non-empty enhancement queue therefore
-	 * prints 50-120 lines a second on a release build - the function this
-	 * was lifted from (video_receiver.c) carries no log line at all.
-	 * Rate-limited so it still says what happened without becoming the
-	 * fault it is reporting.
-	 */
-	pr_info_ratelimited("dvel: bl %u el %u - dropping %d surplus el frame(s)\n",
